rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Conteúdo global (curado) ---
    // Leitura: qualquer usuário logado.
    // Escrita: só o UID admin (você) pode popular/atualizar o conteúdo global.
    // Troque "COLOQUE_SEU_UID_AQUI" pelo seu UID do Firebase Auth
    // (Console > Authentication > Users > coluna "User UID").
    match /content/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "18Uv2Goc7cOdVPErrFV81COmvnT2";
    }

    // --- Dados pessoais do usuário ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Validação extra nas tarefas (texto livre digitado pelo usuário):
      // limita tamanho do título e restringe a categoria a valores esperados.
      // Evita abuso de cota (ex: título gigante) e dados malformados quebrando a UI.
      match /tarefas/{tarefaId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() <= 200
          && request.resource.data.categoria in ["trabalho", "estudo", "bemestar"];
      }

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bloqueia tudo que não foi explicitamente liberado acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
